# NVIDIA NeMo Data Designer deployment — shared config.
# Copy to `.env` in this directory and fill in. `.env` is gitignored.
#
# These are consumed by every env adapter (fly/, future aws/, gcp/, k8s/).

# --- NVIDIA / NGC (required to pull the private nvcr.io images) ---------------
# NGC API key with "NGC Catalog" + "Public API Endpoints" permissions.
# https://org.ngc.nvidia.com/setup/api-key
NGC_CLI_API_KEY=

# NVIDIA image tag to deploy (matches the compose bundle you downloaded).
NEMO_MICROSERVICES_IMAGE_TAG=25.12

# Path to the docker-compose.yaml from NVIDIA's NGC bundle, e.g.
#   ngc registry resource download-version \
#     "nvidia/nemo-microservices/nemo-data-designer-docker-compose:25.12"
COMPOSE_FILE=./nemo-data-designer-docker-compose/docker-compose.yaml

# --- Inference backend -------------------------------------------------------
# Data Designer needs a model backend. Pick ONE path:
#
#  (a) OpenAI  — no GPU, cheapest to host. Data Designer calls OpenAI directly.
#      Set OPENAI_API_KEY; the app's presets already default provider "openai".
OPENAI_API_KEY=
#
#  (b) NVIDIA-hosted NIM (build.nvidia.com) — no local GPU, NVIDIA models.
#      Set NIM_API_KEY. Leave blank if using OpenAI only.
NIM_API_KEY=

# --- Fly.io adapter (see fly/) ----------------------------------------------
# All FLY_* vars below are OPTIONAL — the script falls back to these same
# defaults if they're unset, and creates the app only if it doesn't exist.
# Fly app name (must be globally unique).
FLY_APP=nemo-data-designer
# Machine memory. 8gb is the floor; the full stack often wants 16gb.
FLY_MEMORY=16gb
# Public port for the Data Designer API inside the machine.
FLY_PORT=8080
# Persistent volume size (GB) for Postgres / Data Store.
FLY_VOLUME_SIZE=25
# Fly region (https://fly.io/docs/reference/regions/).
FLY_REGION=iad
