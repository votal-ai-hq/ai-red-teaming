# ── LLM Provider Keys (at least one required) ──
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# NVIDIA_API_KEY=                 # For nim provider (NVIDIA-hosted: integrate.api.nvidia.com)
# NIM_BASE_URL=                   # Optional: override for self-hosted NIM endpoint (e.g. http://localhost:8000/v1)
# HF_TOKEN=                       # For huggingface provider (serverless router or dedicated Inference Endpoints)
# HUGGINGFACE_API_KEY=            # Alternative env var name accepted by the huggingface provider
# HF_BASE_URL=                    # Optional: dedicated HF Inference Endpoint /v1 URL (e.g. https://<id>.endpoints.huggingface.cloud/v1)

# ── LiteLLM guardrail report (scripts/litellm_guardrails_report_v2.py) ──
# Target endpoint + model for the with/without-guardrails run. Each is
# overridden by the matching CLI flag. Defaults shown.
# LITELLM_BASE_URL=http://localhost:4000      # target proxy base URL            (--base-url)
# LITELLM_ENDPOINT=/v1/chat/completions       # chat-completions path            (--endpoint)
# LITELLM_MODEL=qwen3.5-27b                    # target model name                (--model)
# LITELLM_API_KEY=                              # target proxy bearer token; optional, open if unset (--api-key)
# LITELLM_GUARDRAILS=votal-input-guard,votal-output-guard   # guardrail names    (--guardrail)
# JUDGE_MODEL=claude-opus-4-5-20251101         # Anthropic verdict-judge model    (--judge-model)
# ATTACK_REFINE_MODEL=                          # Anthropic attack-refine model; blank = same as judge

# ── Enterprise Mode (optional — skip for quick local testing) ──
# DATABASE_URL=postgres://redteam:redteam_dev@postgres:5432/redteam
# MASTER_ENCRYPTION_KEY=   # Generate with: openssl rand -hex 32
# AUTH_MODE=dev             # Local only. Forbidden when NODE_ENV=production.
# DEV_API_KEY=              # Required with AUTH_MODE=dev; >=16 chars; do not use 'dev-key'
# NODE_ENV=development      # Keep off 'production' while AUTH_MODE=dev
# CLERK_PUBLISHABLE_KEY=   # For production SSO (omit AUTH_MODE when using this)
